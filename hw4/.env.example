# Copy to .env and fill in. Never commit the real file.

# Use either a Portkey key or a direct OpenAI key. Portkey wins when both are set.
PORTKEY_API_KEY=your-portkey-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Model the shop agent runs on.
AGENT_MODEL=gpt-4o-mini

# Signs the session tokens issued at login. Any long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: point the backend at a database somewhere other than hw4/data/campus_customs.db
# CAMPUS_CUSTOMS_DB=C:/path/to/campus_customs.db
